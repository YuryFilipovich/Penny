# Server-only secrets. Never prefix API keys with VITE_.
OPENAI_API_KEY=
JEV_API_KEY=
# PDF + structured output capable model. Change to a model available to your account.
OPENAI_MODEL=gpt-4.1
JEV_MODEL=jev-latest
# Applied together with a minimum selected-option probability of 0.70.
JEV_CONFIDENCE_THRESHOLD=0.75
PORT=8787

# Self-hosted Grocy root URL (an /api suffix also works). Server-only.
GROCY_URL=http://127.0.0.1:9283
GROCY_API_KEY=

# Docker publishes on loopback by default. Set an address on your host only if
# trusted devices on your LAN should reach Penny.
PENNY_BIND_IP=127.0.0.1
PENNY_PORT=18787
APP_ORIGINS=http://127.0.0.1:18787
DAILY_RECEIPT_LIMIT=10
RECEIPT_TIMEZONE=Europe/Warsaw
# Local npm start only; Compose sets its own persistent volume path.
DAILY_USAGE_FILE=usage/daily-usage.json
